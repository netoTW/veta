{
  "name": "veta-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n servidor,vite -c cyan,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "servidor": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "produccion": "NODE_ENV=production tsx server/index.ts",
    "preview": "VETA_SERVIR_DIST=1 PORT=5310 BETTER_AUTH_URL=http://localhost:5310 tsx server/index.ts",
    "datos": "node scripts/datos.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint",
    "invariantes": "node scripts/invariantes.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.4",
    "better-sqlite3": "^12.11.1",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "hono": "^4.13.7",
    "lenis": "^1.3.26",
    "lightweight-charts": "^5.2.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "three": "^0.185.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "ffmpeg-static": "^5.3.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.64.0",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
