{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "ignoreCommand": "bash scripts/vercel-ignorar.sh",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.vetalab.io/api/:path*"
    },
    {
      "source": "/:pantalla(analisis|analizar|contacto|cuenta|entrar|gemas|gracias|metodologia|nosotros|noticias|piezas|precios|privacidad|recuperar|registro|restablecer|seguimiento|sistema|terminos|votacion|watchlist)",
      "destination": "/index.html"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9_-]{0,23})",
      "destination": "https://api.vetalab.io/api/ir/:slug"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "trailingSlash": false
}
