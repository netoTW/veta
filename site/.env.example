# VETA · entorno local. Este archivo NO se commitea (.gitignore).
# NODE_ENV no va acá: Vite también lee este archivo y compilaría en modo desarrollo. En producción se pone en el entorno del proceso.
PORT=8787
BETTER_AUTH_SECRET=<32 bytes aleatorios en base64url>
BETTER_AUTH_URL=http://localhost:5173
VETA_ORIGENES=http://localhost:5173,http://localhost:5310
VETA_DB=server/data/veta.sqlite
VETA_DATOS=server/datos
VETA_BASE_CONTENIDO=../datos-motor/base_contenido
VETA_REPORTS_DIR=../datos-motor/reports
VETA_HORAS_ANTICIPO=6
VETA_CUPO_BASE=2
VETA_CUPO_PRO=6
VETA_CORREO=archivo
# Primer admin (se crea al arrancar si no existe)
VETA_ADMIN_EMAIL=<correo del primer admin>
VETA_ADMIN_PASSWORD=<contraseña inicial del admin, mínimo 10 caracteres>
# Cuentas de prueba gratis@veta.local / base@veta.local / pro@veta.local (sólo en desarrollo)
VETA_DEMO_PASSWORD=<contraseña de las cuentas de prueba; vacío para no crearlas>

# Motor: simulado (recorre etapas sin gastar) | http (servicio real: .venv/bin/python gem-pipeline/servicio/app.py)
VETA_MOTOR=simulado
VETA_MOTOR_URL=http://127.0.0.1:8787

# Servidor del motor: rutas /operacion por el túnel SSH (ssh -i ~/.ssh/veta_vps -f -N -L 8788:127.0.0.1:8787 root@<ip>)
VETA_OPERACION_URL=http://127.0.0.1:8788
VETA_OPERACION_TOKEN=            # el de /opt/veta/.env del servidor; nunca en git
VETA_SERVIDOR_SSH=root@<ip>
VETA_SERVIDOR_CLAVE=~/.ssh/veta_vps
VETA_SERVIDOR_RUTA=/opt/veta/gem-pipeline
VETA_SYNC_MINUTOS=10

# Luffy (Mugiwara, CONTRATO-PANEL.md): el panel /luffy. Sin token responde un simulador con la forma del contrato.
# Con túnel al servidor: ssh -i ~/.ssh/veta_vps -f -N -L 8800:127.0.0.1:8800 root@<ip> y el token de /opt/mugiwara/.env
VETA_LUFFY=simulado
MUGIWARA_API_URL=http://127.0.0.1:8800
MUGIWARA_API_TOKEN=

# Base: sin DATABASE_URL se usa SQLite (VETA_DB). En producción, la URI del session pooler de Supabase.
DATABASE_URL=
# Correo: archivo (local) | smtp (producción, VETA_SMTP_URL=smtps://usuario:clave@host:465)
VETA_CORREO=archivo
VETA_SMTP_URL=
VETA_CORREO_DESDE=VETA <no-responder@tu-dominio>
# Sincronización: ssh (rsync desde otra máquina) | local (la API corre junto al motor y sólo recompila)
VETA_SYNC_MODO=ssh

# ---------- Cobro con Whop ----------
# Clave de la API (empresa Vetalab). Sólo en el servidor: nunca en el repositorio.
VETA_WHOP_API_KEY=
# Secreto del webhook que da Whop al registrar la URL (ws_...). Sin él no se procesa ningún aviso.
VETA_WHOP_WEBHOOK_SECRETO=
# Identificadores de plan de Whop. Mientras estén vacíos, /precios sigue con el botón de correo.
VETA_WHOP_PLAN_BASE=
VETA_WHOP_PLAN_PRO=
# A dónde vuelve el usuario después de pagar.
VETA_WHOP_RETORNO=https://www.vetalab.io/gracias
