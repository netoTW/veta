# /opt/veta-web/site/.env — producción (Contabo). Permisos 600, propietario veta. Nunca en git.
# NODE_ENV NO va acá: lo pone la unidad de systemd.

# --- dominio y origen (una sola cookie, un solo origen: el de Vercel) ---
BETTER_AUTH_URL=https://vetalab.io
VETA_ORIGENES=https://vetalab.io
BETTER_AUTH_SECRET=                     # openssl rand -base64 48

# --- base de datos: Supabase (Postgres), URI del pooler en modo SESSION (puerto 5432) ---
DATABASE_URL=postgresql://postgres.REF:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- primer admin (se crea al arrancar si no existe) ---
VETA_ADMIN_EMAIL=
VETA_ADMIN_PASSWORD=

# --- contenido: el motor está en este mismo servidor ---
VETA_BASE_CONTENIDO=/opt/veta/gem-pipeline/base_contenido
VETA_REPORTS_DIR=/opt/veta/gem-pipeline/reports
VETA_DATOS=/opt/veta-web/datos
VETA_SYNC_MODO=local
VETA_SYNC_MINUTOS=10

# --- motor a pedido y operación: mismo servidor, sin túnel ---
VETA_MOTOR=http
VETA_MOTOR_URL=http://127.0.0.1:8787
VETA_OPERACION_URL=http://127.0.0.1:8787
VETA_OPERACION_TOKEN=                   # el mismo de /opt/veta/.env

# --- cupos y gasto ---
VETA_CUPO_BASE=2
VETA_CUPO_PRO=6
VETA_TOPE_MENSUAL_USD=60
VETA_COSTO_ESTIMADO_USD=1.8
VETA_HORAS_ANTICIPO=6

# --- correo de recuperación de contraseña (Resend, Postmark, Gmail con clave de aplicación…) ---
VETA_CORREO=smtp
VETA_SMTP_URL=smtps://resend:re_XXXX@smtp.resend.com:465
VETA_CORREO_DESDE=VETA <no-responder@vetalab.io>
